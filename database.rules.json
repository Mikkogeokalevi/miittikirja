{
  "rules": {
    "miitit": {
      "$uid": {
        ".write": "$uid === auth.uid",
        "calendar": {
          ".read": "$uid === auth.uid",
          ".write": "$uid === auth.uid"
        },
        "events": {
          ".read": true,
          ".indexOn": ["date"],
          "$eventId": {}
        },
        "photos": {
          ".read": true
        },
        "logs": {
          ".read": true,
          "$eventId": {
            "$logId": {
              ".write": "!data.exists() && newData.exists()",
              "message": {
                ".write": "data.parent().exists() && newData.isString()",
                ".validate": "newData.val().length <= 500"
              },
              "messageUpdatedAt": {
                ".write": "data.parent().exists() && newData.isNumber()",
                ".validate": true
              }
            }
          }
        },
        "nicks": {
          ".read": true,
          "$nick": {
            "n": {
              ".write": "newData.isNumber() && ((!data.exists() && newData.val() >= 1) || newData.val() === data.val() + 1)"
            },
            "first": {
              ".write": "newData.isNumber() && !data.exists()"
            },
            "last": {
              ".write": "newData.isNumber() && (!data.exists() || newData.val() >= data.val())"
            },
            "raw": {
              ".write": "newData.isString() && newData.val().length <= 80 && !data.exists()"
            },
            "ev": {
              "$eventId": {
                ".write": "newData.isNumber() && !data.exists()"
              }
            }
          }
        },
        "reactions": {
          ".read": true,
          "$eventId": {
            "$emoji": {
              ".write": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999 && ((!data.exists() && newData.val() <= 1) || (data.exists() && newData.val() >= data.val() - 1 && newData.val() <= data.val() + 1))"
            }
          }
        },
        "externalEvents": {
          ".read": "$uid === auth.uid",
          ".write": "$uid === auth.uid"
        }
      }
    }
  }
}

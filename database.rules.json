{
  // ============================================================
  // Firebase Realtime Database -säännöt (perhekalenteri-projekti)
  //
  // SISÄLTÄÄ KAIKEN: muut projektit (tapahtumat, tehtavalista,
  // ajopaivakirja, users, refuelings, poi) + miittikirja (miitit).
  //
  // MIITTIKIRJA-MUUTOS vs vanhat säännöt:
  //   logs/{logId}/message + messageUpdatedAt saivat oman
  //   .write-säännön — vieras voi päivittää oman viestinsä
  //   ("muokkaa viestiä" -toiminto). Muut kentät pysyvät
  //   vain-luonti-tilassa kuten ennen.
  // ============================================================
  "rules": {
    "tapahtumat": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "tehtavalista": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "ajopaivakirja": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid",
        ".indexOn": ["startTime"]
      }
    },
    "users": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid"
      }
    },
    "refuelings": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid"
      }
    },
    "miitit": {
      "$uid": {
        ".write": "$uid === auth.uid",
        "calendar": {
          ".read": "$uid === auth.uid",
          ".write": "$uid === auth.uid"
        },
        "events": {
          ".read": true,
          ".indexOn": ["date"],
          "$eventId": {}
        },
        "logs": {
          ".read": true,
          "$eventId": {
            "$logId": {
              ".write": "!data.exists() && newData.exists()",
              "message": {
                ".write": "data.parent().exists() && newData.isString()",
                ".validate": "newData.val().length <= 500"
              },
              "messageUpdatedAt": {
                ".write": "data.parent().exists() && newData.isNumber()",
                ".validate": true
              }
            }
          }
        },
        "externalEvents": {
          ".read": "$uid === auth.uid",
          ".write": "$uid === auth.uid"
        }
      }
    },
    "poi": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid"
      }
    }
  }
}
